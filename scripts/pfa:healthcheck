set -e

echo "\n\n-- Market Child Checking..."

docker exec pfa-market-child /bin/bash -c "bash docker-scripts/health-check" || exit 1
echo "-- Healthy!!"

echo "\n-- Market Checking..."

docker exec pfa-market /bin/sh -c "sh health-check" || exit 1
echo "-- Healthy!!"

echo "\n-- Product Redis Checking..."

docker exec pfa-product-redis /bin/sh -c "sh health-check" || exit 1
echo "-- Healthy!!"

echo "\n-- Product Checking..."

docker exec pfa-product /bin/sh -c "sh health-check" || exit 1
echo "-- Healthy!!"